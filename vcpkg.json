{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dice-engine",
  "version-string": "0.1.0",
  "description": "FTEQW-based engine (client, server and tools).",
  "builtin-baseline": "aeac3fa8d321bf9451d8dfacc62a476b5a956916",
  "vcpkg-configuration": {
    "overlay-ports": [ "./ports" ]
  },
  "dependencies": [
    "zlib",
    "bzip2",
    "libjpeg-turbo",
    "libpng",
    {
      "name": "freetype",
      "default-features": false,
      "features": [ "zlib", "png", "bzip2" ]
    },
    "libogg",
    "libvorbis",
    "opus",
    "speex",
    "speexdsp",
    "vulkan-headers",
    {
      "name": "glew",
      "platform": "windows"
    },
    {
      "name": "glm",
      "platform": "windows"
    },
    {
      "name": "sdl2",
      "features": [ "vulkan" ]
    },
    {
      "name": "imgui",
      "features": [
        "opengl2-binding",
        "opengl3-binding",
        "sdl2-binding",
        { "name": "win32-binding", "platform": "windows" }
      ]
    },
    {
      "name": "openal-soft",
      "platform": "windows"
    }
  ],
  "features": {
    "sdl2": {
      "description": "Build the SDL2 platform layer instead of the native Win32/X11 one.",
      "dependencies": [
        {
          "name": "sdl2",
          "features": [ "vulkan" ]
        },
        {
          "name": "imgui",
          "features": [ "sdl2-binding" ]
        }
      ]
    }
  }
}
