{
  "name": "imgui",
  "version": "1.93.0",
  "description": "Dear ImGui, pinned to the v1.93.0-docking tag (overlay port for dice-engine).",
  "homepage": "https://github.com/ocornut/imgui",
  "license": "MIT",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "freetype": {
      "description": "Build font atlases using FreeType instead of stb_truetype",
      "dependencies": [
        "freetype"
      ]
    },
    "opengl2-binding": {
      "description": "Make available OpenGL (legacy) binding"
    },
    "opengl3-binding": {
      "description": "Make available OpenGL3/ES/ES2 (modern) binding"
    },
    "sdl2-binding": {
      "description": "Make available SDL2 binding",
      "dependencies": [
        "sdl2"
      ]
    },
    "win32-binding": {
      "description": "Make available Win32 binding",
      "supports": "windows & !uwp"
    }
  }
}
