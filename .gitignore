# Engine build output (build_win64.sh / engine/Makefile)
engine/release/
engine/debug/
engine/profile/
engine/libs-*/
engine/*.tar.gz

# Copied from bin/<game>/engine.h and icon by Nuclide's engine targets
engine/common/config_base.h
engine/common/base.ico

# Nuclide: junctions to ./engine and ./plugins, recreated by build_win64.sh
/bin/ThirdParty/
/bin/build/
/build/
/bin/*.exe
/bin/*.dll
/bin/identity.pfx
/bin/*.lst
/bin/base/*.dat
/bin/base/*.lno
/bin/base/maps/*.dat
/bin/base/maps/*.lno
/bin/base/progs/*.dat
/bin/base/progs/*.lno
/bin/base/src/**/*.lno

# Written by the engine at runtime
/bin/conhistory.txt
/bin/base/config.cfg
/bin/base/data/*.log
