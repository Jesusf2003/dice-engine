# Engine build output (build_win64.sh / engine/Makefile)
engine/release/
engine/debug/
engine/profile/
engine/libs-*/
engine/*.tar.gz

# Copied from bin/<game>/engine.h and icon by the archived Nuclide engine targets (docs/nuclide)
engine/common/config_base.h
engine/common/base.ico

/build/
/bin/*.exe
/bin/*.dll
/bin/identity.pfx
/bin/*.lst
# demo game: compiled QuakeC (build_win64.sh game) and compiled maps (build_win64.sh maps)
/bin/demo/*.dat
/bin/demo/*.lno
/bin/demo/maps/*.bsp
/bin/demo/maps/*.srf
/bin/demo/maps/*.prt
/bin/demo/maps/*.lin
# LibreQuake data packs used by the demo (~190 MB), kept out of git
/bin/demo/*.pak

# Written by the engine at runtime
/bin/conhistory.txt
/bin/demo/screenshots/
/bin/demo/qconsole.log

# vmap (build_win64.sh vmap): MSYS2 packages it links against, objects, and the
# installed exe + DLLs in tools/vmap/bin, IntelliSense database (absolute paths)
/tools/vmap/deps/
/tools/vmap/**/*.o
/tools/vmap/**/*.a
/tools/vmap/vmap.exe
/tools/vmap/bin/
/tools/vmap/build/
/tools/vmap/compile_commands.json
# Local notes and code set aside (e.g. docs/radar, docs/nuclide: the archived Nuclide SDK and base game)
/docs/

