  OBJECT_DIR = CMakeFiles\plug_xmpp.dir
  POST_BUILD = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\VSCodeProjects\CppProjects\dice-engine\build && \bin\echo -e "{\n	package fteplug_xmpp\n	ver \"main-50-git-bf92bcc-dirty\"\n	category Plugins\n	title \"XMPP Plugin\"\n	gamedir \"\"\n	desc \"XMPP/Jabber instant messenger plugin for chatting without tabbing out.\"\n}" | zip -q -9 -fz- F:/VSCodeProjects/CppProjects/dice-engine/build/fteplug_xmpp.dll.zip - && cmake -E cat F:/VSCodeProjects/CppProjects/dice-engine/build/fteplug_xmpp.dll.zip >> F:/VSCodeProjects/CppProjects/dice-engine/build/fteplug_xmpp.dll && zip -A F:/VSCodeProjects/CppProjects/dice-engine/build/fteplug_xmpp.dll && cmake -E rm F:/VSCodeProjects/CppProjects/dice-engine/build/fteplug_xmpp.dll.zip"
