// Ninja Wars - FGD para J.A.C.K. (Jackhammer)
// Motor: FTEQW (BSP29). Compilador: ericw-tools (qbsp / vis / light).
//
// Solo se listan entidades que existen en src/*.qc o que ericw-tools procesa al compilar.
// Si a�ades un spawn function nuevo en QuakeC, a��delo aqu� tambi�n.

//
// Clases base
//

@BaseClass = Targetname
[
	targetname(target_source) : "Nombre"
]

@BaseClass = Target
[
	target(target_destination) : "Objetivo"
]

// Claves que qbsp/light de ericw-tools leen en cualquier entidad de brushes.
@BaseClass = EricwBrush
[
	_shadow(choices) : "Proyecta sombras (light)" : 0 =
	[
		0 : "No"
		1 : "Si"
	]
	_minlight(integer) : "Luz m�nima de este brush (light)" : 0
	_mincolor(color255) : "Color de la luz m�nima (light)" : "255 255 255"
	_phong(choices) : "Suavizado phong (light)" : 0 =
	[
		0 : "No"
		1 : "Si"
	]
]

//
// Mundo
//

@SolidClass = worldspawn : "Mundo"
[
	message(string) : "Nombre del mapa"
	wad(string) : "WADs de texturas (separados por ;)" : "textures.wad"

	// FTEQW
	sky(string) : "Skybox (FTE: gfx/env/<nombre>rt.tga, bk, lf, ft, up, dn)"
	fog(string) : "Niebla (FTE: densidad r g b), ej. 0.05 0.3 0.3 0.3"

	// ericw-tools light: iluminaci�n global
	light(integer) : "Luz m�nima global" : 0
	_minlight_color(color255) : "Color de la luz m�nima" : "255 255 255"
	_range(string) : "Escala de distancia de las luces" : "0.5"
	_gamma(string) : "Gamma del lightmap" : "1.0"

	// ericw-tools light: sol
	_sunlight(integer) : "Intensidad del sol" : 0
	_sun_mangle(string) : "Direcci�n del sol (yaw pitch roll)" : "0 -90 0"
	_sunlight_color(color255) : "Color del sol" : "255 255 255"
	_sunlight_penumbra(integer) : "Penumbra del sol (grados)" : 0

	// ericw-tools light: c�pula de cielo (luz ambiente desde el cielo)
	_sunlight2(integer) : "Intensidad de la c�pula de cielo" : 0
	_sunlight2_color(color255) : "Color de la c�pula de cielo" : "255 255 255"

	// ericw-tools light: oclusi�n ambiental y rebote
	_dirt(choices) : "Oclusi�n ambiental (dirtmapping)" : 0 =
	[
		0 : "Desactivada"
		1 : "Activada"
	]
	_dirtscale(string) : "Escala de la oclusi�n" : "1.0"
	_bounce(choices) : "Luz rebotada" : 0 =
	[
		0 : "Desactivada"
		1 : "Activada"
	]
	_bouncescale(string) : "Escala del rebote" : "1.0"
]

//
// Jugador
//

// Tama�o = setsize() de PlayerSpawn en sv_player.qc: el origen est� en los pies.
// El jugador aparece en origin + '0 0 1' y cae hasta el suelo.
@PointClass size(-16 -16 0, 16 16 56) color(0 255 0) = info_player_start : "Punto de aparici�n del jugador"
[
	angle(integer) : "Direcci�n (yaw)" : 0
]

//
// Utilidades
//

// No hace nada en el juego. Sirve como destino de focos (light con target).
@PointClass base(Targetname) size(-4 -4 -4, 4 4 4) color(0 128 255) = info_null : "Punto vac�o (destino de focos)"
[
]

//
// Luces (solo compilaci�n)
//

// light.exe hornea estas luces en el lightmap. En el juego, light() hace remove(self).
// worldspawn no llama a lightstyle(), as� que no hay estilos animados ni luces conmutables.
@PointClass base(Target) size(-8 -8 -8, 8 8 8) color(255 255 64) = light : "Luz (horneada por light.exe)"
[
	light(integer) : "Intensidad" : 300
	_color(color255) : "Color" : "255 255 255"
	wait(string) : "Atenuaci�n por distancia (mayor = alcance menor)" : "1.0"
	delay(choices) : "Tipo de atenuaci�n" : 0 =
	[
		0 : "Lineal"
		1 : "Inversa (1/x)"
		2 : "Inversa al cuadrado (1/x�)"
		3 : "Sin atenuaci�n"
		4 : "Minlight local (sin atenuaci�n ni sombras)"
		5 : "Inversa al cuadrado (variante suavizada)"
	]
	_deviance(integer) : "Radio de luz suave (unidades)" : 0
	_samples(integer) : "Muestras de luz suave" : 16
	_dirt(choices) : "Oclusi�n ambiental en esta luz" : 0 =
	[
		0 : "Seg�n worldspawn"
		1 : "Forzar activada"
		-1 : "Forzar desactivada"
	]
	_anglescale(string) : "Influencia del �ngulo de incidencia (0-1)" : "0.5"

	// Foco: apuntar con target -> info_null, o con mangle.
	mangle(string) : "Direcci�n del foco (yaw pitch roll)"
	angle(integer) : "Apertura del foco (grados)" : 40
	_softangle(integer) : "Borde suave del foco (grados)" : 0
]

//
// Brushes
//

// Brush visible sin colisi�n. Lo crea func_illusionary() en sv_triggers.qc.
@SolidClass base(EricwBrush) color(128 128 255) = func_illusionary : "Brush sin colisi�n"
[
]

// Solo compilaci�n: qbsp fusiona estos brushes con el mundo.
@SolidClass base(EricwBrush) color(200 200 200) = func_group : "Grupo de brushes (se fusiona con el mundo)"
[
]

// Solo compilaci�n: brushes que no dividen el �rbol BSP (acelera vis, no tapan visibilidad).
@SolidClass base(EricwBrush) color(160 160 160) = func_detail : "Brush de detalle"
[
]

@SolidClass base(EricwBrush) color(160 160 220) = func_detail_illusionary : "Detalle sin colisi�n"
[
]

@SolidClass base(EricwBrush) color(160 220 160) = func_detail_wall : "Detalle que no recorta caras de otros brushes"
[
]
