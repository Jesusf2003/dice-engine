// Ninja Wars - FGD for J.A.C.K. (Jackhammer)
// Map compiler: Ericw's tools

//
// Base classes
//
@BaseClass = Targetname
[
	targetname(target_source) : "Name"
]

@BaseClass = Target
[
	target(target_destination) : "Target"
]

@BaseClass = EricwBrush
[
	_shadow(choices) : "Casts shadows (light)" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
	_minlight(integer) : "Minimum light for this brush (light)" : 0
	_mincolor(color255) : "Minimum light color (light)" : "255 255 255"
	_phong(choices) : "Phong smoothing (light)" : 0 =
	[
		0 : "No"
		1 : "Yes"
	]
]

//
// World
//

@SolidClass = worldspawn : "World"
[
	message(string) : "Map name"
	wad(string) : "Texture WADs (separated by ;)" : "textures.wad"

	// FTEQW
	sky(string) : "Skybox (FTE: gfx/env/<name>rt.tga, bk, lf, ft, up, dn)"
	fog(string) : "Fog (FTE: density r g b), e.g. 0.05 0.3 0.3 0.3"

	// ericw-tools light: global lighting
	light(integer) : "Global minimum light" : 0
	_minlight_color(color255) : "Minimum light color" : "255 255 255"
	_range(string) : "Light distance scale" : "0.5"
	_gamma(string) : "Lightmap gamma" : "1.0"

	// ericw-tools light: sun
	_sunlight(integer) : "Sun intensity" : 0
	_sun_mangle(string) : "Sun direction (yaw pitch roll)" : "0 -90 0"
	_sunlight_color(color255) : "Sun color" : "255 255 255"
	_sunlight_penumbra(integer) : "Sun penumbra (degrees)" : 0

	// ericw-tools light: sky dome (ambient light from the sky)
	_sunlight2(integer) : "Sky dome intensity" : 0
	_sunlight2_color(color255) : "Sky dome color" : "255 255 255"

	// ericw-tools light: ambient occlusion and bounce
	_dirt(choices) : "Ambient occlusion (dirtmapping)" : 0 =
	[
		0 : "Disabled"
		1 : "Enabled"
	]
	_dirtscale(string) : "Occlusion scale" : "1.0"
	_bounce(choices) : "Bounced light" : 0 =
	[
		0 : "Disabled"
		1 : "Enabled"
	]
	_bouncescale(string) : "Bounce scale" : "1.0"
]

//
// Player
//

@PointClass color(255 0 0) size(-16 -16 0, 16 16 56) = info_player_start : "Player spawn point"
[
	angle(integer) : "Direction (yaw)" : 0
]

//
// Utilities
//

@PointClass base(Targetname) size(-4 -4 -4, 4 4 4) color(0 128 255) = info_null : "Empty point (spotlight target)"
[
]

//
// Lights (compile only)
//

@BaseClass = LightBase
[
	light(integer) : "Intensity" : 300
	_color(color255) : "Color" : "255 255 255"
	wait(string) : "Distance falloff (higher = shorter range)" : "1.0"
	delay(choices) : "Falloff type" : 0 =
	[
		0 : "Linear"
		1 : "Inverse (1/x)"
		2 : "Inverse square (1/x^2)"
		3 : "No falloff"
		4 : "Local minlight (no falloff or shadows)"
		5 : "Inverse square (smoothed variant)"
	]
	_deviance(integer) : "Soft light radius (units)" : 0
	_samples(integer) : "Soft light samples" : 16
	_dirt(choices) : "Ambient occlusion on this light" : 0 =
	[
		0 : "Use worldspawn"
		1 : "Force enabled"
		-1 : "Force disabled"
	]
	_anglescale(string) : "Angle of incidence influence (0-1)" : "0.5"
]

@PointClass base(LightBase, Target) size(-8 -8 -8, 8 8 8) color(255 255 64) = light : "Point light (baked by light.exe)" []

@PointClass base(LightBase, Target) size(-8 -8 -8, 8 8 8) color(255 200 64) = light_spot : "Spotlight (baked by light.exe)"
[
	mangle(string) : "Spotlight direction (yaw pitch roll)"
	angle(integer) : "Spotlight cone angle (degrees)" : 40
	_softangle(integer) : "Spotlight soft edge (degrees)" : 0
]
@PointClass base(LightBase) size(-8 -8 -8, 8 8 8) color(255 255 200) = light_sun : "Sun (baked by light.exe)"
[
	_sun(integer) : "Is sun (leave at 1)" : 1
	mangle(string) : "Sun direction (yaw pitch roll)" : "0 -90 0"
	_sunlight_penumbra(integer) : "Sun penumbra (degrees)" : 0
]

//
// Brushes
//

@SolidClass base(EricwBrush) color(128 128 255) = func_illusionary : "Non-colliding brush" []
@SolidClass base(EricwBrush) color(200 200 200) = func_group : "Brush group (merged into world)" []
@SolidClass base(EricwBrush) color(160 160 160) = func_detail : "Detail brush" []
@SolidClass base(EricwBrush) color(160 200 220) = func_detail_fence : "Detail for fence/grate textures ({ prefix), solid, never clips world faces" []
@SolidClass base(EricwBrush) color(160 160 220) = func_detail_illusionary : "Non-colliding detail" []
@SolidClass base(EricwBrush) color(160 220 160) = func_detail_wall : "Detail that doesn't clip other brushes' faces" []
@SolidClass base() color(255 200 0) = func_ladder : "Climbable volume (invisible, place against a wall)" []
@SolidClass base() color(220 160 160) = func_test : "prints a message" []