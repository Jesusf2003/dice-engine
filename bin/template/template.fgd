// Template - entity definitions for radiant (tools/radiant), in its FGD dialect:
//	wadlist	property type: the texture wads, one entry per wad as "path" : "description",
//			paths relative to the game folder. radiant loads every one of them into the
//			texture browser; the default value is what a new map's "wad" key gets.
//
// Every class here has a function of the same name in src/server/sv_entities.qc.

//
// World
//

@SolidClass = worldspawn : "World"
[
	message(string) : "Map name"
	wad(wadlist) : "Texture WADs" : "./template.wad" =
	[
		"./template.wad" : "Template"
	]
	light(integer) : "Global minimum light (light.exe)" : 0
]

//
// Point entities
//

@PointClass color(255 0 0) size(-16 -16 -24, 16 16 32) = info_player_start : "Player spawn point"
[
	angle(integer) : "Direction (yaw)" : 0
]

@PointClass size(-8 -8 -8, 8 8 8) color(255 255 64) = light : "Point light"
[
	light(integer) : "Brightness" : 300
	_color(color1) : "Color (r g b, 0 to 1)" : "1 1 1"
]
