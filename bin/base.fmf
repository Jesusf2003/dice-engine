FTEMANIFEST 1	// version identifier
GAME quake	// same as -quake via the command-line, tells the engine we're QuakeWorld
GAMEDIR base	// mount base/ as our main game directory

// Game info read by the menu (src/platform/gamelibrary.qc): every "-set gameinfo_<key>" is a <key> of the old liblist.gam
-set gameinfo_game "Nuclide II: Mayhem"
-set gameinfo_title "Mayhem"
-set gameinfo_subtitle "Nuclide + LibreQuad"
-set gameinfo_version "1.0"
-set gameinfo_url_info "www.vera-visions.com"
-set gameinfo_type "singleplayer_only"
-set gameinfo_startmap "starting_demo"
-set gameinfo_trainingmap "dev"
-set gameinfo_menumap "background01"
-set gameinfo_readme "readme.txt"
-set gameinfo_chatroom "lobby"
-set gameinfo_nomodels "1"
-set gameinfo_nohimodels "1"
