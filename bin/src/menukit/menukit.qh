/** @defgroup menukit MenuKit
@brief Menu runtime for games that build their menu out of VGUI widgets.

MenuKit owns everything the engine expects from a menu progs (m_init, m_draw,
input, m_toggle, the loading screen, console commands) and a desktop widget
that holds the main-menu buttons and any windows the game opens.
The game only describes its menu.

# Setting it up in a game

`<game>/src/menu/progs.src`:

```
#pragma target fte_5768
#pragma progs_dat  "../../menu.dat"
#define MENU
#define GAME_DIR "mygame"

#includelist
../../../src/menukit/includes.src
menu.qc
#endlist
```

`<game>/src/menu/menu.qc`:

```
void
Game_MenuInit(void)
{
	Menu_ShowGameTitle();
	Menu_AddButton("New Game", "gfx/icon16/new", MyGame_NewGame, MENU_OFFLINE);
	Menu_AddButton("Resume Game", "gfx/icon16/control_play", Menu_Resume, MENU_INGAME);
	Menu_AddButton("Options", "gfx/icon16/cog", MyGame_Options, MENU_ALWAYS);
	Menu_AddButton("Quit", "gfx/icon16/stop", Menu_ShowQuitDialog, MENU_ALWAYS);
}
```

Submenus are ordinary vguiWindow objects: create them once, hand them to
Menu_Add(), and show them from a button with Menu_ShowCentered().

The guide is @ref menus (Documentation/Menus.md); src/menukit/example/ is a working menu.

*/

/** When a main-menu button is visible. */
typedef enumflags
{
	MENU_OFFLINE,	/**< in the main menu, no game running (or a background map) */
	MENU_INGAME	/**< in the pause menu of a running game */
} menuVisibility_t;

#define MENU_ALWAYS (MENU_OFFLINE | MENU_INGAME)

/* game hooks ---------------------------------------------------------------- */

/** Builds the game's menu. Called once from m_init, after the platform and VGUI are up.
Every game implements this; without it the menu only offers Console and Quit.
@ingroup menukit */
void Game_MenuInit(void);

/** Draws behind the menu every frame. The default draws the background map or image.
@ingroup menukit */
void Game_MenuDraw(vector screenSize);

/** Draws the loading screen. The default is the VGUI loading panel over the background.
@ingroup menukit */
void Game_MenuLoading(vector screenSize, float isOpaque);

/** Console commands the game registered with registercommand().
Return true when the command was handled.
@ingroup menukit */
bool Game_MenuConsoleCommand(string commandName, int argCount);

/* building the menu ------------------------------------------------------- */

/** Shows the game's title above the main-menu buttons: the gameinfo_title of the game manifest (<game>.fmf),
or gfx/title.mat when there is no title text. */
void Menu_ShowGameTitle(void);

/** Adds a main-menu button. Buttons stack in the order they are added.
@param title text on the button
@param icon 16x16 image, or "" for none
@param func called when the button is clicked
@param visibility MENU_OFFLINE, MENU_INGAME or MENU_ALWAYS
@return the button, for further tweaks (SetKeyEquivalent, SetIcon, ...) */
vguiMenuButton Menu_AddButton(string title, string icon, void(void) func, menuVisibility_t visibility);

/** Leaves an empty row between the buttons added before and after. */
void Menu_AddSpacer(void);

/** Adds a widget (usually a vguiWindow) to the menu desktop. Do this once per window. */
void Menu_Add(vguiWidget toAdd);

/** Shows a window centred on screen, adding it to the desktop if it isn't there yet. */
void Menu_ShowCentered(vguiWindow window);

/* stock actions, usable as button functions --------------------------------- */

/** Closes the menu and returns to the running game. */
void Menu_Resume(void);
/** Leaves the running game. */
void Menu_Disconnect(void);
/** Asks "Do you wish to stop playing now?" and quits on confirmation. */
void Menu_ShowQuitDialog(void);
/** Opens the compact VGUI console window. */
void Menu_ShowConsole(void);

/* state ------------------------------------------------------------------- */

/** True while a game is running (not counting the menu background map). */
bool Menu_InGame(void);
/** The desktop widget that holds the buttons and windows. */
vguiWidget Menu_Desktop(void);
