/** @defgroup worldtext World Text
    @brief 2D text drawn at a projected 3D position (debug overlays, in-world messages).
    @ingroup client

    @{
 */

/** Returns true when p1 is within 512 units of p2 (on the XY plane), inside a loose
    field of view of ang, and not hidden behind world geometry. */
bool WorldText_Visible(vector p1, vector p2, vector ang);

/** Draws message centered over the projection of org, with a drop shadow. */
void WorldText_DrawString(vector org, string message);

/** Draws message as a text field of the given width, centered over the projection of org. */
void WorldText_DrawField(vector org, string message, float width);

/** @} */ // end of worldtext
