/** @defgroup rendertarget Monitor Render Target
    @brief Renders a second camera into the "base" render target, which materials
    can display (e.g. a func_monitor screen). One active camera at a time.
    @ingroup client

    @{
 */

/** Activates (or with active false, stops) the monitor camera. */
void RenderTarget_SetMonitor(bool active, vector pos, vector ang, float fov, vector size);

/** Called by ncView every frame after the main scene is rendered. */
void RenderTarget_UpdateMonitor(void);

/** @} */ // end of rendertarget
