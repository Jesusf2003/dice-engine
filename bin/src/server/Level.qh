/** @defgroup level Level Start & Transitions
    @brief Map-start triggering and the landmark/changetarget state carried across
    a level change. The entities (trigger_auto, trigger_changelevel, info_landmark)
    belong to the game; the SDK finds them by classname.
    @ingroup server

    @{
 */

/** Offset of the activating player from the info_landmark, set by the level change
    on the previous map and applied by Landmark_GetSpot on the new one. */
vector g_landmarkpos;

/** Called once the first player is in the game: sends the "MapStart" input to every
    trigger_auto. Only acts once per map. */
void Level_PlayerReady(void);

/** Where a player arriving through a level change should spawn: the info_landmark
    named after startspot, plus g_landmarkpos. */
vector Landmark_GetSpot(void);

/** Returns g_landmarkpos. */
vector Landmark_GetPosition(void);

/** Fires the targetname stored in the _bsp_changetarget cvar (after _bsp_changedelay
    seconds), which a level change sets for the map it goes to. */
void ChangeTarget_Activate(void);

/** @} */ // end of level
