{
	"version": "2.0.0",
	"tasks": [
		{
			//Compiles qwprogs.dat, csprogs.dat and menu.dat (progs.src pulls in all three .src files).
			"label": "fteqcc: compilar ninjawars",
			"type": "process",
			"command": "${workspaceFolder}/bin/fteqcc64.exe",
			"args": ["-srcfile", "progs.src"],
			"options": {
				"cwd": "${workspaceFolder}/bin/ninjawars/src"
			},
			"group": { "kind": "build", "isDefault": true },
			"presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
			//fteqcc prints "file.qc:24: error: msg" / "file.qc:10: warning F302: msg", relative to src/.
			"problemMatcher": {
				"owner": "quakec",
				"fileLocation": ["relative", "${workspaceFolder}/bin/ninjawars/src"],
				"pattern": {
					"regexp": "^(.*?\\.qc):(\\d+):\\s+(error|warning)[^:]*:\\s*(.*)$",
					"file": 1,
					"line": 2,
					"severity": 3,
					"message": 4
				}
			}
		}
	]
}
