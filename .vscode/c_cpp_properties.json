				"${workspaceFolder}/engine/client",
				"${workspaceFolder}/engine/server",
				"${workspaceFolder}/engine/gl",
				"${workspaceFolder}/engine/qclib",
				"${workspaceFolder}/engine/libs-x86_64-w64-mingw32",
				"${workspaceFolder}/plugins"
			],
			"defines": [
				"_WIN32",
				"MULTITHREAD",
				"CONFIG_FILE_NAME=config_fteqw.h"
			]
		}
	],
	"version": 4
